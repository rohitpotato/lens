{
  "name": "@lens/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":        { "types": "./dist/index.d.ts",  "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./events": { "types": "./dist/events.d.ts", "default": "./dist/events.js" }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file-if-exists=../../.env node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file-if-exists=../../.env node_modules/.bin/drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "vitest": "^2.1.5"
  }
}
