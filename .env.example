# Postgres
POSTGRES_USER=lens
POSTGRES_PASSWORD=lens
POSTGRES_DB=lens
POSTGRES_PORT=5432
DATABASE_URL=postgres://lens:lens@localhost:5432/lens

# Redis
# Host port bumped to 6380 to avoid collision with a common
# brew-services redis on :6379. Container-internal port stays 6379.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lens-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info

# Guardrails for the passwordless public deployment
LENS_UPLOADS_PER_HOUR_PER_IP=30
LENS_DAILY_COST_USD=5
