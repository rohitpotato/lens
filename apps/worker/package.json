{
  "name": "@lens/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lens/db": "workspace:*",
    "@lens/llm": "workspace:*",
    "@lens/metrics": "workspace:*",
    "@lens/pipeline": "workspace:*",
    "@lens/queue": "workspace:*",
    "@lens/storage": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
