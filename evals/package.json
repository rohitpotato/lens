{
  "name": "@lens/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "lens-eval": "./src/bin/eval.ts"
  },
  "scripts": {
    "eval": "tsx --env-file=../.env src/bin/eval.ts",
    "synth": "tsx --env-file=../.env src/bin/synth.ts",
    "import:docile": "tsx --env-file=../.env src/bin/import.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lens/llm": "workspace:*",
    "@lens/pipeline": "workspace:*",
    "pdfkit": "^0.15.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
